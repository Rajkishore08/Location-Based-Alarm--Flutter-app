{
  "auth": {
    "providers": {
      "anonymous": true,
      "emailPassword": true,
      "googleSignIn": {
        "authorizedRedirectUris": [
          "https://smart-location-alaram.web.app/__/auth/handler",
          "https://smart-location-alaram.firebaseapp.com/__/auth/handler",
          "http://localhost"
        ]
      }
    }
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
